{
  "width": 600,
  "height": 450,
  "background": null,
  "data": {
    "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
    "format": {
      "type": "topojson",
      "feature": "austates"
    }
  },
  "projection": {
    "type": "mercator",
    "scale": 650,
    "center": [
      134,
      -28
    ]
  },
  "transform": [
    {
      "calculate": "datum.id == 0 ? 'New South Wales' : datum.id == 1 ? 'Victoria' : datum.id == 2 ? 'Queensland' : datum.id == 3 ? 'South Australia' : datum.id == 4 ? 'Western Australia' : datum.id == 5 ? 'Tasmania' : datum.id == 6 ? 'Northern Territory' : 'Unknown'",
      "as": "state"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/observations_by_state.csv"
        },
        "key": "state",
        "fields": [
          "observations"
        ]
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#B8B1A1",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "observations",
          "type": "quantitative",
          "title": "Wildlife observations",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              600000
            ],
            "range": [
              "#E7E2D3",
              "#C7D3BC",
              "#91AB87",
              "#5F8064",
              "#315843"
            ]
          },
          "legend": {
            "orient": "right",
            "titleColor": "#27302A",
            "labelColor": "#27302A",
            "format": "~s",
            "values": [
              0,
              150000,
              300000,
              450000,
              600000
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "observations",
            "type": "quantitative",
            "title": "Observations",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "WA",
            "longitude": 121.5,
            "latitude": -25.5
          },
          {
            "state": "NT",
            "longitude": 133.5,
            "latitude": -19.5
          },
          {
            "state": "SA",
            "longitude": 135.0,
            "latitude": -30.5
          },
          {
            "state": "QLD",
            "longitude": 144.5,
            "latitude": -23.0
          },
          {
            "state": "NSW",
            "longitude": 147.0,
            "latitude": -32.5
          },
          {
            "state": "VIC",
            "longitude": 144.5,
            "latitude": -37.2
          },
          {
            "state": "TAS",
            "longitude": 146.5,
            "latitude": -42.0
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "sans-serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#27302A"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
