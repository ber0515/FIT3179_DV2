{
  "width": 620,
  "height": 330,
  "background": null,
  "data": {
    "url": "data/state_group_counts.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.observations)",
      "as": "obs_num"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "obs_num",
          "as": "state_total"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum.obs_num / datum.state_total",
      "as": "state_share"
    }
  ],
  "encoding": {
    "x": {
      "field": "group",
      "type": "nominal",
      "title": "Wildlife group",
      "sort": [
        "Bird",
        "Mammal",
        "Reptile",
        "Amphibian"
      ],
      "axis": {
        "labelColor": "#27302A",
        "titleColor": "#27302A",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "Australian Capital Territory",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory"
      ],
      "axis": {
        "labelColor": "#27302A"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#F4F1E8",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "state_share",
          "type": "quantitative",
          "title": "Share of state observations",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              "#F3E8D7",
              "#E4C59A",
              "#D39B5C",
              "#B66E3F",
              "#82472F"
            ]
          },
          "legend": {
            "orient": "right",
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "titleColor": "#27302A",
            "labelColor": "#27302A"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "Wildlife group"
          },
          {
            "field": "state_share",
            "type": "quantitative",
            "title": "Share",
            "format": ".1%"
          },
          {
            "field": "obs_num",
            "type": "quantitative",
            "title": "Observations",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "state_share",
          "type": "quantitative",
          "format": ".0%"
        },
        "color": {
          "condition": {
            "test": "datum.state_share >= 0.5",
            "value": "#FFFFFF"
          },
          "value": "#27302A"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
