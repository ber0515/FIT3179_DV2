{
  "width": 620,
  "height": 250,
  "background": "#F4F1E8",

  "data": {
    "url": "data/month_group_counts.csv"
  },

  "mark": {
    "type": "rect",
    "stroke": "#F4F1E8",
    "strokeWidth": 2
  },

  "encoding": {
   "x": {
    "field": "month",
    "type": "ordinal",
    "sort": [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
    ],
    "title": "Month",
    "axis": {
        "labelExpr": "substring(datum.label, 0, 3)",
        "labelAngle": 0,
        "labelColor": "#27302A",
        "titleColor": "#27302A"
    }
    },

    "y": {
      "field": "group",
      "type": "nominal",
      "sort": ["Bird", "Mammal", "Reptile", "Amphibian"],
      "title": null,
      "axis": {
        "labelColor": "#27302A",
        "labelFontSize": 12
      }
    },

    "color": {
      "field": "observations",
      "type": "quantitative",
      "title": "Observations",
      "scale": {
        "type": "sqrt",
        "range": [
          "#E1E9DF",
          "#B8CAB4",
          "#88A884",
          "#527858",
          "#18392B"
        ]
      },
      "legend": {
        "orient": "right",
        "format": "~s",
        "titleColor": "#27302A",
        "labelColor": "#27302A"
      }
    },

    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Wildlife group"
      },
      {
        "field": "month",
        "type": "ordinal",
        "title": "Month"
      },
      {
        "field": "observations",
        "type": "quantitative",
        "title": "Observations",
        "format": ","
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}