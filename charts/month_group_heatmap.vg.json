{
  "width": 620,
  "height": 300,
  "background": null,
  "data": {
    "url": "data/month_group_counts.csv"
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "sort": [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
      ],
      "title": "Month",
      "axis": {
        "labelExpr": "substring(datum.label, 0, 3)",
        "labelAngle": 0,
        "labelColor": "#27302A",
        "titleColor": "#27302A",
        "titleFontWeight": "bold",
        "grid": false
      }
    },
    "y": {
      "field": "observations",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Wildlife group",
      "scale": {
        "domain": [
          "Bird",
          "Mammal",
          "Reptile",
          "Amphibian"
        ],
        "range": [
          "#4F7EA8",
          "#D96C4F",
          "#718355",
          "#4F8A7B"
        ]
      },
      "legend": {
        "orient": "right",
        "titleColor": "#27302A",
        "labelColor": "#27302A",
        "titleFontWeight": "bold"
      }
    },
    "order": {
      "field": "group",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "Wildlife group"
      },
      {
        "field": "month",
        "type": "ordinal",
        "title": "Month"
      },
      {
        "field": "observations",
        "type": "quantitative",
        "title": "Observations",
        "format": ","
      }
    ]
  },
  "mark": {
    "type": "area",
    "opacity": 0.9,
    "stroke": "#F4F1E8",
    "strokeWidth": 1
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
