{
  "width": 520,
  "height": 420,

  "background": "#F4F1E8",

  "data": {
    "url": "data/observations_by_group.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 95,
        "outerRadius": 175,
        "stroke": "#F4F1E8",
        "strokeWidth": 3
      },

      "encoding": {
        "theta": {
          "field": "observations",
          "type": "quantitative",
          "stack": true
        },

        "color": {
          "field": "group",
          "type": "nominal",
          "title": "Wildlife group",

          "scale": {
            "domain": [
              "Bird",
              "Mammal",
              "Reptile",
              "Amphibian"
            ],

            "range": [
              "#18392B",
              "#527858",
              "#89A986",
              "#BFD0BB"
            ]
          },

          "legend": {
            "orient": "right",
            "labelColor": "#27302A",
            "titleColor": "#27302A"
          }
        },

        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Wildlife group"
          },
          {
            "field": "observations",
            "type": "quantitative",
            "title": "Observations",
            "format": ","
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 17,
        "fontWeight": "bold",
        "color": "#18392B"
      },

      "encoding": {
        "text": {
          "value": "Observations"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}