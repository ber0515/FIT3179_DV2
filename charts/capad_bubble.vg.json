{
  "width": 600,
  "height": 450,
  "background": null,
  "projection": {
    "type": "mercator",
    "scale": 650,
    "center": [
      134,
      -28
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D9D5C9",
        "stroke": "#F4F1E8",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/capad_jurisdiction.csv"
      },
      "transform": [
        {
          "calculate": "datum.protected_area_ha / 1000000",
          "as": "protected_area_mha"
        },
        {
          "calculate": "datum.jurisdiction == 'WA' ? 121 : datum.jurisdiction == 'NT' ? 133 : datum.jurisdiction == 'SA' ? 135 : datum.jurisdiction == 'QLD' ? 145 : datum.jurisdiction == 'NSW' ? 151 : datum.jurisdiction == 'VIC' ? 145 : datum.jurisdiction == 'TAS' ? 147 : 149",
          "as": "longitude"
        },
        {
          "calculate": "datum.jurisdiction == 'WA' ? -25 : datum.jurisdiction == 'NT' ? -19 : datum.jurisdiction == 'SA' ? -30 : datum.jurisdiction == 'QLD' ? -23 : datum.jurisdiction == 'NSW' ? -32 : datum.jurisdiction == 'VIC' ? -37 : datum.jurisdiction == 'TAS' ? -42 : -35.3",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#F4F1E8",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "protected_area_mha",
          "type": "quantitative",
          "title": "Protected area (million ha)",
          "scale": {
            "type": "sqrt",
            "range": [
              120,
              3200
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Protected area",
            "values": [
              5,
              20,
              40,
              80
            ],
            "labelExpr": "datum.value + 'm ha'",
            "titleColor": "#27302A",
            "labelColor": "#27302A"
          }
        },
        "color": {
          "field": "percent_protected",
          "type": "quantitative",
          "title": "Land protected (%)",
          "scale": {
            "domain": [
              0,
              60
            ],
            "range": [
              "#DCE7DA",
              "#AFC6A8",
              "#779A76",
              "#456D52",
              "#18392B"
            ]
          },
          "legend": {
            "orient": "right",
            "titleColor": "#27302A",
            "labelColor": "#27302A",
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "jurisdiction",
            "type": "nominal",
            "title": "Jurisdiction"
          },
          {
            "field": "protected_area_mha",
            "type": "quantitative",
            "title": "Protected area",
            "format": ".1f"
          },
          {
            "field": "percent_protected",
            "type": "quantitative",
            "title": "Jurisdiction protected",
            "format": ".1f"
          },
          {
            "field": "protected_areas",
            "type": "quantitative",
            "title": "Number of protected areas",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/capad_jurisdiction.csv"
      },
      "transform": [
        {
          "calculate": "datum.jurisdiction == 'WA' ? 121 : datum.jurisdiction == 'NT' ? 133 : datum.jurisdiction == 'SA' ? 135 : datum.jurisdiction == 'QLD' ? 145 : datum.jurisdiction == 'NSW' ? 151 : datum.jurisdiction == 'VIC' ? 145 : datum.jurisdiction == 'TAS' ? 147 : 149",
          "as": "longitude"
        },
        {
          "calculate": "datum.jurisdiction == 'WA' ? -25 : datum.jurisdiction == 'NT' ? -19 : datum.jurisdiction == 'SA' ? -30 : datum.jurisdiction == 'QLD' ? -23 : datum.jurisdiction == 'NSW' ? -32 : datum.jurisdiction == 'VIC' ? -37 : datum.jurisdiction == 'TAS' ? -42 : -35.3",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#27302A"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "jurisdiction",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
