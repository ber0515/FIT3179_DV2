{
  "width": 700,
  "height": 360,
  "background": null,
  "data": {
    "url": "data/year_species_counts.csv"
  },
  "transform": [
    {
      "filter": "datum.year == 2021 || datum.year == 2025"
    },
    {
      "pivot": "year",
      "value": "observations",
      "groupby": [
        "common_name",
        "group"
      ]
    },
    {
      "filter": "isValid(datum['2021']) && isValid(datum['2025']) && datum['2021'] > 0"
    },
    {
      "calculate": "datum['2021']",
      "as": "obs_2021"
    },
    {
      "calculate": "datum['2025']",
      "as": "obs_2025"
    },
    {
      "calculate": "((datum.obs_2025 - datum.obs_2021) / datum.obs_2021) * 100",
      "as": "pct_change"
    },
    {
      "calculate": "datum.obs_2025 - datum.obs_2021",
      "as": "abs_change"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#8F8A7D",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "size": 22
      },
      "encoding": {
        "y": {
          "field": "common_name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "pct_change",
            "order": "descending"
          },
          "axis": {
            "labelColor": "#27302A",
            "labelFontSize": 12,
            "labelLimit": 190
          }
        },
        "x": {
          "field": "pct_change",
          "type": "quantitative",
          "title": "Change in observations from 2021 to 2025 (%)",
          "axis": {
            "grid": true,
            "gridColor": "#DDD5C4",
            "labelColor": "#5F6F63",
            "titleColor": "#27302A",
            "labelExpr": "datum.value + '%'"
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "Wildlife group",
          "scale": {
            "domain": [
              "Bird",
              "Mammal",
              "Reptile",
              "Amphibian"
            ],
            "range": [
              "#4F7EA8",
              "#D96C4F",
              "#718355",
              "#4F8A7B"
            ]
          },
          "legend": {
            "orient": "right",
            "labelColor": "#27302A",
            "titleColor": "#27302A"
          }
        },
        "tooltip": [
          {
            "field": "common_name",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "Wildlife group"
          },
          {
            "field": "obs_2021",
            "type": "quantitative",
            "title": "2021 observations",
            "format": ","
          },
          {
            "field": "obs_2025",
            "type": "quantitative",
            "title": "2025 observations",
            "format": ","
          },
          {
            "field": "abs_change",
            "type": "quantitative",
            "title": "Absolute change",
            "format": "+,"
          },
          {
            "field": "pct_change",
            "type": "quantitative",
            "title": "Percentage change",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#27302A"
      },
      "encoding": {
        "y": {
          "field": "common_name",
          "type": "nominal",
          "sort": {
            "field": "pct_change",
            "order": "descending"
          }
        },
        "x": {
          "field": "pct_change",
          "type": "quantitative"
        },
        "text": {
          "field": "pct_change",
          "type": "quantitative",
          "format": "+.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
